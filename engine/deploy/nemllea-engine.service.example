[Unit]
Description=NemlleA Document Processing Engine
After=network.target

[Service]
Type=simple
User=engineuser
Group=engineuser
WorkingDirectory=/opt/nemllea-engine
EnvironmentFile=/opt/nemllea-engine/.env
ExecStart=/opt/nemllea-engine/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nemllea-engine/storage-data

[Install]
WantedBy=multi-user.target
